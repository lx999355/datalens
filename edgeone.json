{
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate && node scripts/cleanup-engines.js && npm run build && node scripts/cleanup-engines.js",
  "outputDirectory": ".next",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": [
        "@prisma/client",
        "cos-nodejs-sdk-v5",
        "bcryptjs"
      ],
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
