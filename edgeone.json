{
  "installCommand": "npm install --omit=dev && npm install @tailwindcss/postcss tailwindcss",
  "buildCommand": "npx prisma generate && node scripts/cleanup-engines.js && npm run build",
  "outputDirectory": ".next/standalone",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
